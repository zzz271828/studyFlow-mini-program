.container {
  padding: 16px;
}

.header {
  margin-bottom: 16px;
}

.title {
  display: block;
  font-size: 22px;
  font-weight: 600;
  margin-bottom: 4px;
}

.subtitle {
  display: block;
  font-size: 13px;
  color: #888;
}

.section-title {
  font-size: 14px;
  font-weight: 500;
  margin: 12px 0;
}

.room-card {
  background-color: #ffffff;
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 10px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.room-name {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 4px;
}

.room-info {
  font-size: 13px;
  color: #666;
  margin-bottom: 2px;
}

.room-time {
  font-size: 12px;
  color: #999;
}
