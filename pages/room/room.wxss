/* pages/room/room.wxss */

/* ===== Page ===== */
.page {
  background-color: #f4f7fb;
  min-height: 100vh;
  font-size: 28rpx;
  padding-bottom: 140rpx; /* leave space for bottom bar */
}

/* ===== Card ===== */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 12rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, 0.08);
}

.room-info {
  margin-top: 24rpx;
}

.room-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: #1e3a8a;
}

.room-location {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 6rpx;
}

.room-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.room-footer text {
  display: block;
  font-size: 24rpx;
  color: #475569;
}

/* ===== Section ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  color: #1e293b;
}

/* ===== Seat Grid ===== */
.seat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.seat {
  height: 120rpx;
  border-radius: 14rpx;
  border: 2rpx solid #93c5fd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.15s ease;
}

/* Free seat */
.seat-free {
  background: #e8f0ff;
  color: #2563eb;
}

/* Selected seat */
.seat-selected {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}

/* ===== Bottom Confirm Bar ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(37, 99, 235, 0.15);
}

.confirm-btn {
  width: 100%;
  border-radius: 16rpx;
  background-color: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
}

/* ===== Time Picker ===== */
.picker-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.35);
  z-index: 999;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx;
  z-index: 1000;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1e3a8a;
}

.picker-item {
  padding: 22rpx;
  border: 1rpx solid #c7d2fe;
  border-radius: 16rpx;
  color: #1e40af;
}

.picker-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.picker-btn {
  padding: 16rpx 28rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
}
