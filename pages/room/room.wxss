/* pages/room/room.wxss */

.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  font-size: 28rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 12rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.room-info {
  margin-top: 24rpx;
}

.room-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.room-location {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

.room-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.room-footer text {
  display: block;
  font-size: 24rpx;
  color: #666666;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

/* 座位布局：2 x 2 */
.seat-grid {
  margin-top: 8rpx;
}

.seat-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-bottom: 10rpx;
}

.seat {
  width: 100rpx;
  height: 100rpx;
  margin: 8rpx;
  border-radius: 12rpx;
  text-align: center;
  line-height: 100rpx;
  font-size: 32rpx;
}

/* 默认：可选的绿色边框 */
.seat-free {
  border: 2rpx solid #1AAD19;
  color: #1AAD19;
  background-color: #e8f9ee;
}

/* 选中：实心绿色 */
.seat-selected {
  background-color: #1AAD19;
  color: #ffffff;
}

/* 底部主按钮 */
.primary-button {
  background-color: #1AAD19;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
}
