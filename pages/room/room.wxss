/* pages/room/room.wxss */

.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  font-size: 28rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 12rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.room-info {
  margin-top: 24rpx;
}

.room-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.room-location {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

.room-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.room-footer text {
  display: block;
  font-size: 24rpx;
  color: #666666;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

/* 座位布局：2 x 2 */
.seat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr); /* 4 columns */
  gap: 16rpx;
  margin-top: 16rpx;
}

.seat {
  height: 120rpx;
  border-radius: 12rpx;
  border: 2rpx solid #22c55e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.seat-free {
  background: #eaffef;
  color: #16a34a;
}

.seat-selected {
  background: #22c55e;
  color: #fff;
}


/* 底部主按钮 */
.primary-button {
  background-color: #1AAD19;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.picker-mask{
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 999;
}

.picker-panel{
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx;
  z-index: 1000;
}

.picker-title{
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.picker-item{
  padding: 22rpx;
  border: 1rpx solid #eee;
  border-radius: 16rpx;
}

.picker-actions{
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.picker-btn{
  padding: 16rpx 26rpx;
  background: #22c55e;
  color: #fff;
  border-radius: 16rpx;
}

