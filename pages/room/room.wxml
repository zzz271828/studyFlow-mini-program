<view class="page">
  <!-- 房间信息卡片 -->
  <view class="card room-info">
    <view class="room-name">{{room.name}}</view>
    <view class="room-location">{{room.location}}</view>
    <view class="room-desc">{{room.description}}</view>
    <view class="room-footer">
      <text>地址：{{room.location}}</text>
      <text>今日空位：{{room.todaySeats}}</text>
      <text>开放时间：{{room.openTime}} - {{room.closeTime}}</text>
    </view>
  </view>

  <!-- 座位区域 -->
  <view class="card">
    <view class="section-title">请选择一个座位（示例 20 个）</view>

    <view class="seat-grid">
      <view
        wx:for="{{seats}}"
        wx:key="id"
        class="seat {{item.status === 'selected' ? 'seat-selected' : 'seat-free'}}"
        data-seat-id="{{item.id}}"
        bindtap="onSeatTap"
      >
        {{item.label}}
      </view>

      <view wx:if="{{showTimePicker}}" class="picker-mask" bindtap="onCloseTimePicker"></view>

      <view wx:if="{{showTimePicker}}" class="picker-panel">
        <view class="picker-title">选择时间</view>

        <picker mode="selector" range="{{timeSlots}}" value="{{timeSlotIndex}}" bindchange="onTimeChange">
          <view class="picker-item">
            {{selectedTimeRange || '点击选择时间段'}}
          </view>
        </picker>

        <view class="picker-actions">
          <view class="picker-btn" bindtap="onCloseTimePicker">完成</view>
        </view>
      </view>


    </view>

    <view wx:if="{{selectedSeatId}}" class="hint">
      已选座位：{{selectedSeatId}}
      <text wx:if="{{selectedTimeRange}}">｜时间：{{selectedTimeRange}}</text>
    </view>

  </view>
</view>